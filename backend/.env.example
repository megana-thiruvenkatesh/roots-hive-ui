PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hive_roots
JWT_SECRET=hive-roots-change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# Show MFA code in browser redirect during local POC (set false in real deploy)
DEV_SHOW_OTP=true

# Google OAuth (any Google account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Microsoft: leave CLIENT_* empty + MICROSOFT_DEV_LOGIN=true for local POC
# (email form → MFA, no Azure portal). Fill CLIENT_ID/SECRET for real OAuth.
MICROSOFT_DEV_LOGIN=true
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
